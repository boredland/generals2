# Bulk archive data is local-only (EA-copyrighted); only our own manifests are committed.
archive/videos/**
!archive/videos/**/
!archive/videos/**/*.info.json
!archive/videos/MANIFEST.csv
!archive/videos/FAILED.txt
!archive/videos/.downloaded.txt
archive/local/**
!archive/local/INDEX.md
!archive/local/SHA256SUMS
archive/wayback/**
!archive/wayback/*.csv
!archive/wayback/*.md
!archive/wayback/FAILED.txt
archive/ia/**
# Upstream archives can contain .json/.txt that the video negations above would re-include.
archive/**/extracted/
vendor/**/build/
/build/
